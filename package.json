{
  "name": "codepromax",
  "version": "0.1.0",
  "description": "Analyzes a repository, discovers evidence-backed engineering improvement initiatives, and generates planning documents for them. CLI + MCP server.",
  "keywords": ["code-analysis", "technical-debt", "mcp", "mcp-server", "developer-tools"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bishoy-bishai/CodeProMax.git"
  },
  "bin": {
    "codepro": "bin/codepro.js",
    "codepro-mcp": "bin/mcp-server.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "start:mcp": "node bin/mcp-server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
